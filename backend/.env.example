# ====================================================================
# FlawTrack Backend Environment Configuration
# ====================================================================

# Environment mode: 'production', 'development', or 'test'
NODE_ENV=production

# Server listening port (Render sets this dynamically via process.env.PORT)
PORT=5000

# MongoDB Atlas Connection URI
# Must include database name (/flawtrack) and URL-encoded password characters
# Example: mongodb+srv://flawtrack_user:StrongPassword123%21@cluster0.abcde.mongodb.net/flawtrack?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flawtrack?retryWrites=true&w=majority
# Backwards-compatible alias:
# MONGODB_URI=mongodb://localhost:27017/flawtrack

# JWT Signing Secret (Generate 64 random characters: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Origin for CORS and secure cookie domain matching
# Must match the deployed Vercel frontend URL exactly (NO trailing slash!)
# In local dev: http://localhost:5173
CLIENT_URL=https://flawtrack.vercel.app
# Backwards-compatible alias:
# FRONTEND_URL=https://flawtrack.vercel.app

# Cloudinary Storage (Required for Production - No local disk writes)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Threat Intelligence (CISA KEV + EPSS)
# 'offline' uses local snapshots, 'online' fetches live feeds every 24h
THREAT_INTEL_MODE=offline

# Local Upload Fallback Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Optional SMTP Notifications
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=flawtrack-alerts@example.com
