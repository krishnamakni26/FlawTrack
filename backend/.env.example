NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/vulntrack
USE_MEMORY_DB=true
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
THREAT_INTEL_MODE=offline
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=vulntrack-alerts@example.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
